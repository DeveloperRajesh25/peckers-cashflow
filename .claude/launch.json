{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "peckers-cashflow",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "peckers-cashflow-lan",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-H",
        "0.0.0.0",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "peckers-cashflow-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3001"
      ],
      "port": 3001
    }
  ]
}
